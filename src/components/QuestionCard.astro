---
import LevelBadge from './LevelBadge.astro';
import { topicMap } from '../data/topics';
const { q, base } = Astro.props;
const t = topicMap[q.data.topic];
---
<a href={`${base}/q/${q.id}/`} data-level={q.data.level} data-id={q.id} data-text={`${q.data.title} ${q.data.tags.join(' ')}`.toLowerCase()}
  style={`--accent:${t?.color}`}
  class="card question-card group flex flex-col p-5">
  <div class="mb-2 flex items-center gap-2">
    <LevelBadge level={q.data.level} />
    {q.data.titleEn && <span class="rounded-md bg-teal-100 px-1.5 py-0.5 text-[11px] font-bold text-teal-700 dark:bg-teal-500/15 dark:text-teal-300">🇬🇧 EN</span>}
    <span class="learned-mark ml-auto hidden text-xs font-semibold text-emerald-600 dark:text-emerald-400">✓ Đã thuộc</span>
  </div>
  <h3 class="font-semibold leading-snug text-slate-900 group-hover:text-[var(--accent)] dark:text-white">{q.data.title}</h3>
  <p class="mt-2 line-clamp-2 text-sm text-slate-600 dark:text-slate-400">{q.data.answer}</p>
  {q.data.tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {q.data.tags.slice(0, 3).map((tag: string) => <span class="rounded-md bg-slate-100 px-1.5 py-0.5 text-[11px] text-slate-500 dark:bg-white/5">#{tag}</span>)}
    </div>
  )}
</a>
