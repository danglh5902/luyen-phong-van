---
const { type = 'tip' } = Astro.props;
const map = {
  tip: ['💡', 'Mẹo', 'border-indigo-500 bg-indigo-50 text-indigo-900 dark:bg-indigo-500/10 dark:text-indigo-100'],
  pitfall: ['⚠️', 'Lỗi hay gặp', 'border-amber-500 bg-amber-50 text-amber-900 dark:bg-amber-500/10 dark:text-amber-100'],
  followup: ['🎯', 'Hỏi thêm', 'border-emerald-500 bg-emerald-50 text-emerald-900 dark:bg-emerald-500/10 dark:text-emerald-100'],
} as const;
const [icon, label, cls] = map[type as keyof typeof map];
---
<aside class={`not-prose my-5 rounded-xl border-l-4 p-4 text-sm leading-relaxed ${cls}`}>
  <p class="mb-1 flex items-center gap-1.5 font-bold"><span>{icon}</span>{label}</p>
  <div class="[&_p]:m-0 [&_code]:rounded [&_code]:bg-black/5 [&_code]:px-1 [&_code]:font-mono dark:[&_code]:bg-white/10"><slot /></div>
</aside>
