---
const { level } = Astro.props;
const m: Record<string, [string, string, string]> = {
  junior: ['Junior', 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300', 'bg-emerald-500'],
  mid: ['Mid', 'bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300', 'bg-amber-500'],
  senior: ['Senior', 'bg-rose-100 text-rose-700 dark:bg-rose-500/15 dark:text-rose-300', 'bg-rose-500'],
};
const [text, cls, dot] = m[level];
---
<span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ${cls}`}>
  <span class={`h-1.5 w-1.5 rounded-full ${dot}`}></span>{text}
</span>
