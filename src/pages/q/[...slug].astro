---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import LearnedButton from '../../components/LearnedButton';
import Callout from '../../components/Callout.astro';
import { getCollection, render } from 'astro:content';
import { topicMap } from '../../data/topics';

export async function getStaticPaths() {
  const all = await getCollection('questions');
  const order = { junior: 0, mid: 1, senior: 2 };
  return all.map((entry) => {
    const sib = all
      .filter((q) => q.data.topic === entry.data.topic)
      .sort((a, b) => order[a.data.level] - order[b.data.level] || a.data.title.localeCompare(b.data.title));
    const i = sib.findIndex((s) => s.id === entry.id);
    return { params: { slug: entry.id }, props: { entry, prev: sib[i - 1], next: sib[i + 1], pos: i + 1, total: sib.length } };
  });
}
const { entry, prev, next, pos, total } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = topicMap[entry.data.topic];
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout title={entry.data.title} description={entry.data.answer}>
  <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[1fr_200px]" style={`--accent:${t.color}`}>
    <article class="min-w-0">
      <nav class="flex items-center gap-2 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={`${base}/`} class="hover:underline">Trang chủ</a><span>/</span>
        <a href={`${base}/topics/${t.id}/`} class="font-medium text-[var(--accent)] hover:underline">{t.name}</a>
        <span class="ml-auto text-xs">Câu {pos}/{total}</span>
      </nav>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <LevelBadge level={entry.data.level} />
        {entry.data.tags.map((tag) => <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-white/5">#{tag}</span>)}
      </div>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white sm:text-4xl">{entry.data.title}</h1>
      {entry.data.titleEn && <p class="mt-2 text-lg font-medium text-slate-500 dark:text-slate-400">🇬🇧 {entry.data.titleEn}</p>}

      <section class="relative my-8 overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--accent)_40%,transparent)] bg-[color-mix(in_srgb,var(--accent)_8%,transparent)] p-6">
        <div class="absolute inset-y-0 left-0 w-1.5 bg-[var(--accent)]"></div>
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">⚡ Trả lời nhanh</p>
        <p class="mt-2 text-lg font-medium leading-relaxed text-slate-900 dark:text-slate-100">{entry.data.answer}</p>
        {entry.data.answerEn && (
          <p class="mt-3 border-t border-[color-mix(in_srgb,var(--accent)_25%,transparent)] pt-3 text-base leading-relaxed text-slate-700 dark:text-slate-300"><span class="mr-1">🇬🇧</span>{entry.data.answerEn}</p>
        )}
      </section>

      <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-p:leading-7">
        <Content components={{ Callout }} />
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-slate-200 pt-6 dark:border-white/10">
        <LearnedButton client:load id={entry.id} />
        <a href={`${base}/flashcards/${t.id}/`} class="text-sm font-medium text-[var(--accent)] hover:underline">🃏 Ôn bằng flashcard</a>
      </div>

      <nav class="mt-8 grid gap-3 sm:grid-cols-2">
        {prev ? <a href={`${base}/q/${prev.id}/`} class="card p-4 text-sm"><span class="text-xs text-slate-400">← Câu trước</span><span class="mt-1 block font-semibold text-slate-900 dark:text-white">{prev.data.title}</span></a> : <span />}
        {next && <a href={`${base}/q/${next.id}/`} class="card p-4 text-right text-sm"><span class="text-xs text-slate-400">Câu sau →</span><span class="mt-1 block font-semibold text-slate-900 dark:text-white">{next.data.title}</span></a>}
      </nav>
    </article>

    {toc.length > 1 && (
      <aside class="hidden lg:block">
        <div class="sticky top-24 text-sm">
          <p class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-400">Nội dung</p>
          <ul class="space-y-1.5 border-l border-slate-200 dark:border-white/10">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="-ml-px block border-l border-transparent pl-3 text-slate-500 hover:border-[var(--accent)] hover:text-slate-900 dark:hover:text-white">{h.text}</a></li>)}
          </ul>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>
