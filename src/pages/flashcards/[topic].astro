---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Flashcard from '../../components/Flashcard';
import { getCollection } from 'astro:content';
import { topics, topicMap } from '../../data/topics';

export function getStaticPaths() {
  return topics.map((t) => ({ params: { topic: t.id } }));
}
const { topic: id } = Astro.params;
const t = topicMap[id!];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const order = { junior: 0, mid: 1, senior: 2 };
const cards = (await getCollection('questions'))
  .filter((q) => q.data.topic === id)
  .sort((a, b) => order[a.data.level] - order[b.data.level])
  .map((q) => ({ id: q.id, title: q.data.title, answer: q.data.answer, level: q.data.level, titleEn: q.data.titleEn, answerEn: q.data.answerEn }));
---
<BaseLayout title={`Flashcard ${t.name}`}>
  <div class="mx-auto max-w-2xl">
    <a href={`${base}/topics/${t.id}/`} class="text-sm font-medium text-indigo-600 hover:underline">← {t.name}</a>
    <h1 class="mb-8 mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">🃏 Flashcard {t.name}</h1>
  </div>
  <Flashcard client:load cards={cards} base={base} color={t.color} />
</BaseLayout>
